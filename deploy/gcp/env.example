# Шаблон /opt/bookamore/.env на GCP e2-micro (PROD).
# Копіюється один раз під час бутстрапу VM, у git не комітиться:
#   cp deploy/gcp/env.example /opt/bookamore/.env && chmod 600 /opt/bookamore/.env
#
# На відміну від старого VPS тут немає FE_PORT/BE_PORT/DB_PORT і UPLOADS_DIR:
# портів на хості не публікуємо взагалі, а дані лежать в іменованих docker-томах.

# --- Образи з GHCR ---------------------------------------------------------
# Значення перезаписує CI на конкретний sha при кожному деплої.
# Для першого ручного запуску згодиться :latest.
BACKEND_IMAGE=ghcr.io/dzheva/bookamore-backend:latest
FRONTEND_IMAGE=ghcr.io/dzheva/bookamore-frontend:latest

# --- Cloudflare Tunnel -----------------------------------------------------
# Токен коннектора з дашборду Zero Trust (Networks → Tunnels → Configure).
# Дає доступ до тунелю — тримати як пароль, у git не класти.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Застосунок ------------------------------------------------------------
# PROD на GCP живе на власному домені bookamore.store (див. README, розділ 5.1).
# alt-web.biz.ua лишився на старому VPS і сюди не заводиться.
#
# Канонічний хост — З www. Апекс віддає 301 на нього (Redirect Rule у Cloudflare),
# тож сюди йде саме www-форма: інакше браузер, прийшовши з апексу, отримав би
# CORS-origin, якого немає в дозволених.
#
# CLIENT_URL має бути РІВНО ОДНИМ URL. Формально SecurityConfig розбиває його по
# комі для CORS-origins, але OAuth2SuccessHandler/FailureHandler підставляють ту
# саму змінну цілим рядком у redirect — список через кому дав би редірект на
# "https://a,https://b/login". Треба кілька origins — спершу розділити змінні.
SPRING_PROFILES_ACTIVE=prod
CLIENT_URL=https://www.bookamore.store
SWAGGER_SERVER_URL=https://www.bookamore.store

# --- База даних ------------------------------------------------------------
DB_NAME=bookamore_prod
DB_USER=bookamore
DB_PASSWORD=

# --- JWT -------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- OAuth2 ----------------------------------------------------------------
# Client ID/secret ті самі, що на старому VPS, АЛЕ домен інший, тож у консолях
# Google/Facebook треба дозволити redirect URI для bookamore.store — без цього
# логін впаде на redirect_uri_mismatch. Деталі — README, розділ 5.4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
