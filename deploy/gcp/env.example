# Шаблон /opt/bookamore/.env на GCP e2-micro (PROD).
# Копіюється один раз під час бутстрапу VM, у git не комітиться:
#   cp deploy/gcp/env.example /opt/bookamore/.env && chmod 600 /opt/bookamore/.env
#
# На відміну від старого VPS тут немає FE_PORT/BE_PORT/DB_PORT і UPLOADS_DIR:
# портів на хості не публікуємо взагалі, а дані лежать в іменованих docker-томах.

# --- Образи з GHCR ---------------------------------------------------------
# Значення перезаписує CI на конкретний sha при кожному деплої.
# Для першого ручного запуску згодиться :latest.
BACKEND_IMAGE=ghcr.io/dzheva/bookamore-backend:latest
FRONTEND_IMAGE=ghcr.io/dzheva/bookamore-frontend:latest

# --- Cloudflare Tunnel -----------------------------------------------------
# Токен коннектора з дашборду Zero Trust (Networks → Tunnels → Configure).
# Дає доступ до тунелю — тримати як пароль, у git не класти.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Застосунок ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
CLIENT_URL=https://bookamore.alt-web.biz.ua
SWAGGER_SERVER_URL=https://bookamore.alt-web.biz.ua

# --- База даних ------------------------------------------------------------
DB_NAME=bookamore_prod
DB_USER=bookamore
DB_PASSWORD=

# --- JWT -------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- OAuth2 ----------------------------------------------------------------
# Ті самі значення, що на старому VPS: домен не змінюється, тож redirect URI
# у консолях Google/Facebook лишаються чинними.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
